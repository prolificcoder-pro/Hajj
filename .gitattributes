# Normalize line endings
* text=auto

# Force LF for these file types
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary assets — no line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
